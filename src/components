import React, { useState } from 'react';
import { procesarAudio } from '../services/api';

const AudioRecorder = ({ onNotaGenerada }) => {
  const [grabando, setGrabando] = useState(false);
  const [cargando, setCargando] = useState(false);
  const [mediaRecorder, setMediaRecorder] = useState(null);

  const iniciarGrabacion = async () => {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const recorder = new MediaRecorder(stream);
    const chunks = [];

    recorder.ondataavailable = (e) => {
      if (e.data.size > 0) {
        chunks.push(e.data);
      }
    };

    recorder.onstop = async () => {
      const blob = new Blob(chunks, { type: 'audio/webm' });
      setCargando(true);
      try {
        const resultado = await procesarAudio(blob);
        onNotaGenerada(resultado);
      } catch (error) {
        alert('Error al procesar el audio: ' + error.message);
      }
      setCargando(false);
    };

    recorder.start();
    setMediaRecorder(recorder);
    setGrabando(true);
  };

  const detenerGrabacion = () => {
    if (mediaRecorder) {
      mediaRecorder.stop();
      mediaRecorder.stream.getTracks().forEach(track => track.stop());
      setGrabando(false);
    }
  };

  return (
    <div>
      <button onClick={iniciarGrabacion} disabled={grabando || cargando}>
        {grabando ? '🔴 Grabando...' : '🎤 Dictar consulta'}
      </button>
      {grabando && (
        <button onClick={detenerGrabacion} style={{ marginLeft: '10px' }}>
          ⏹ Detener
        </button>
      )}
      {cargando && <p>⏳ Procesando con IA...</p>}
    </div>
  );
};

